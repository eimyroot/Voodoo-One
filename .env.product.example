VOODOO_ENV=local
VOODOO_ROOT=/app
VOODOO_DATABASE_BACKEND=sqlite
VOODOO_PRODUCT_DB=/app/storage/product/voodoo_one.sqlite3
VOODOO_PRODUCT_SANDBOX_ROOT=/app/storage/product/sandboxes
VOODOO_IDENTITY_PROVIDER=local
# OIDC remains unreleased and selecting it aborts startup before database initialization.
# VOODOO_OIDC_ISSUER=https://identity.example.com/tenant
# VOODOO_OIDC_AUDIENCE=voodoo-one
# VOODOO_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# VOODOO_OIDC_SUBJECT_CLAIM=sub
# VOODOO_OIDC_USERNAME_CLAIM=preferred_username
# VOODOO_OIDC_GROUPS_CLAIM=groups
VOODOO_SESSION_SIGNING_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
VOODOO_BOOTSTRAP_TOKEN=GENERATE_AT_LEAST_24_RANDOM_BYTES
VOODOO_TOKEN_TTL_SECONDS=3600
VOODOO_AUTH_MAX_FAILURES=5
VOODOO_AUTH_SOURCE_MAX_FAILURES=20
VOODOO_AUTH_WINDOW_SECONDS=300
VOODOO_AUTH_LOCKOUT_SECONDS=900
VOODOO_EXECUTION_TIMEOUT_SECONDS=120
VOODOO_EXECUTION_LEASE_SECONDS=180
VOODOO_LOG_LEVEL=INFO
VOODOO_ALLOW_PRODUCTION_EFFECTS=false
VOODOO_ENABLE_APPROVAL_POLICY_COMPATIBILITY=false
# G8 READ runtime is opt-in only. Production activation is rejected.
VOODOO_G8_READ_RUNTIME=disabled
# When enabled in local/development/staging, inject all values below from a secret/config store.
# Do not use generic GITHUB_TOKEN as a fallback.
# VOODOO_G8_RUNNER_GITHUB_TOKEN=INJECT_DISTINCT_READ_ONLY_RUNNER_TOKEN
# VOODOO_G8_VERIFIER_GITHUB_TOKEN=INJECT_DISTINCT_READ_ONLY_VERIFIER_TOKEN
# VOODOO_G8_RUNNER_PROVIDER_INSTANCE_ID=github-actions:runner:INSTANCE
# VOODOO_G8_VERIFIER_PROVIDER_INSTANCE_ID=github-actions:verifier:INSTANCE
# VOODOO_G8_RUNNER_ROOTFS_DIGEST=64_LOWERCASE_HEX
# VOODOO_G8_RUNNER_RESOURCE_LIMIT_PROFILE_DIGEST=64_LOWERCASE_HEX
# VOODOO_G8_RUNNER_NETWORK_POLICY_DIGEST=64_LOWERCASE_HEX
# VOODOO_G8_VERIFIER_ROOTFS_DIGEST=64_LOWERCASE_HEX
# VOODOO_G8_VERIFIER_RESOURCE_LIMIT_PROFILE_DIGEST=64_LOWERCASE_HEX
# VOODOO_G8_VERIFIER_NETWORK_POLICY_DIGEST=64_LOWERCASE_HEX
# VOODOO_G8_DEPENDENCY_LOCK_DIGEST=64_LOWERCASE_HEX
# VOODOO_G8_SBOM_DIGEST=64_LOWERCASE_HEX
# VOODOO_G8_REVOCATION_EPOCH=0
VOODOO_CORS_ORIGINS=
VOODOO_TRUSTED_HOSTS=localhost,127.0.0.1
