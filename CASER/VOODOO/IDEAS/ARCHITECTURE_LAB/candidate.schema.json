{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-lab-candidate/v1",
  "title": "VOODOO Architecture Lab Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "title",
    "status",
    "source_head",
    "hypothesis",
    "scope",
    "authority",
    "experiment",
    "security",
    "provenance",
    "promotion",
    "rollback",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "architecture-lab-candidate/v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^AL-[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "IDEA",
        "EXPERIMENTING",
        "EVALUATED",
        "PROMOTION_CANDIDATE",
        "REJECTED",
        "ARCHIVED"
      ]
    },
    "source_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "baseline",
        "success_criterion",
        "failure_criterion"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 3
        },
        "baseline": {
          "type": "string",
          "minLength": 3
        },
        "success_criterion": {
          "type": "string",
          "minLength": 3
        },
        "failure_criterion": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_approve",
        "may_authorize",
        "may_execute",
        "may_release",
        "may_deploy",
        "may_widen_authority"
      ],
      "properties": {
        "may_approve": {
          "const": false
        },
        "may_authorize": {
          "const": false
        },
        "may_execute": {
          "const": false
        },
        "may_release": {
          "const": false
        },
        "may_deploy": {
          "const": false
        },
        "may_widen_authority": {
          "const": false
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "metrics"
      ],
      "properties": {
        "environment": {
          "const": "ISOLATED_NON_PRODUCTION"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "direction",
              "baseline",
              "target",
              "guardrail"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "higher_is_better",
                  "lower_is_better",
                  "must_equal"
                ]
              },
              "baseline": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "guardrail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_class",
        "network_required",
        "secrets_required",
        "protected_effects_required"
      ],
      "properties": {
        "risk_class": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "network_required": {
          "type": "boolean"
        },
        "secrets_required": {
          "type": "boolean"
        },
        "protected_effects_required": {
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "revision",
              "license_status"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "repository",
                  "artifact",
                  "model",
                  "dataset",
                  "skill",
                  "paper",
                  "other"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "license_status": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_adoption_required",
        "independent_evidence_required",
        "implementation_authority",
        "release_authority",
        "deployment_authority"
      ],
      "properties": {
        "owner_adoption_required": {
          "const": true
        },
        "independent_evidence_required": {
          "const": true
        },
        "implementation_authority": {
          "const": "NOT_GRANTED"
        },
        "release_authority": {
          "const": "NOT_GRANTED"
        },
        "deployment_authority": {
          "const": "NOT_GRANTED"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "required"
      ],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^/Users/eimyna/0_EVIDENCE/Voodoo-One/ARCHITECTURE_LAB/"
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
